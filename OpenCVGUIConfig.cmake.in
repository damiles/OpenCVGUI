set(OpenCVGUI_VERSION @PROJECT_VERSION@)

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenCV)
find_dependency(OpenGL)
find_dependency(GLEW)
find_dependency(glfw3)

include("${CMAKE_CURRENT_LIST_DIR}/OpenCVGUITargets.cmake")

# Backwards compatible variables
set(OPENCVGUI_LIBRARY OpenCVGUI::OpenCVGUI)
get_target_property(OPENCVGUI_INCLUDE_DIR OpenCVGUI::OpenCVGUI INTERFACE_INCLUDE_DIRECTORIES)

check_required_components(OpenCVGUI)
